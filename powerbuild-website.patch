diff --git a/public/powerbuild/app.js b/public/powerbuild/app.js
new file mode 100644
index 0000000..f884264
--- /dev/null
+++ b/public/powerbuild/app.js
@@ -0,0 +1,44 @@
+'use strict';
+(() => {
+  const config = window.POWERBUILD_CONFIG || {};
+  const $ = id => document.getElementById(id);
+  const el = (tag, text, cls) => { const n = document.createElement(tag); if (text != null) n.textContent = text; if (cls) n.className = cls; return n; };
+  const money = n => new Intl.NumberFormat('en-ZA', {style:'currency',currency:'ZAR'}).format(n);
+  const origin = config.hubOrigin ? new URL(config.hubOrigin).origin : location.origin;
+  const safeURL = value => { try { const u = new URL(value, origin); return ['https:', 'http:'].includes(u.protocol) ? u.href : ''; } catch { return ''; } };
+  let data = null, page = 1, query = '', category = '', request = 0, controller, toastTimer;
+  let basket = [];
+  try { const saved = JSON.parse(localStorage.getItem('powerbuild-basket-v1') || '[]'); if (Array.isArray(saved)) basket = saved.filter(p => Number.isInteger(p.id) && p.id > 0 && typeof p.name === 'string' && Number.isFinite(p.qty) && p.qty > 0 && Number.isFinite(p.price) && p.price >= 0).slice(0,100).map(p => ({...p, qty: Math.min(999, Math.floor(p.qty))})); } catch { /* Private mode or corrupt storage: use an empty list. */ }
+  function save() { try { localStorage.setItem('powerbuild-basket-v1', JSON.stringify(basket)); } catch {} $('count').textContent = basket.reduce((n,p)=>n+p.qty,0); }
+  function toast(message) { $('toast').textContent=message; $('toast').classList.add('visible'); clearTimeout(toastTimer); toastTimer=setTimeout(()=>$('toast').classList.remove('visible'),2500); }
+  function productImage(p, cls) { const url=safeURL(p.image_url); if (!p.image_url || !url) return el('span','POWERBUILD · Image coming soon'); const img=el('img',null,cls); img.src=url; img.alt=p.name; img.loading='lazy'; img.addEventListener('error',()=>img.replaceWith(el('span','Image unavailable')), {once:true}); return img; }
+  function add(p) { if (p.stock_status === 'Unavailable' || p.price_locked) return; const old=basket.find(x=>x.id===p.id); if(old) old.qty=Math.min(999,old.qty+1); else basket.push({id:p.id,code:p.code,name:p.name,price:Math.max(0,Number(p.price)||0),qty:1}); save(); toast('Added to your project basket'); }
+  function detail(p) { const target=$('detail-content'); target.replaceChildren(productImage(p,'detail-image'),el('h3',p.name),el('p',`SKU: ${p.code || '—'} · ${p.category || ''}`),el('p',p.description || 'Contact your branch for product specifications.','detail-description'),el('strong',p.price>0?money(p.price):'Price on request')); const b=el('button','Add to basket','button yellow'); b.disabled=p.stock_status==='Unavailable' || !!p.price_locked; b.onclick=()=>add(p); target.append(el('br'),el('br'),b); $('detail').showModal(); }
+  function selectCategory(value) { category=value; query=''; $('query').value=''; $('category').value=value; page=1; void load(); $('catalogue').scrollIntoView(); }
+  function populateDepartments(categories) { const list=$('department-list'); list.replaceChildren(); const current=$('category').value; $('category').replaceChildren(new Option('All departments','')); categories.forEach((name,i)=> { $('category').add(new Option(name,name)); const b=el('button',null,'department'); b.append(el('b',['▤','◈','⌁','▥','◇','▦'][i%6]),el('span',name)); b.onclick=()=>selectCategory(name); list.append(b); }); $('category').value=current; if (!categories.length) list.append(el('p','No departments are currently published.')); }
+  function renderProducts() { const grid=$('products'); grid.replaceChildren(); if(!data.products.length) grid.append(el('div','No products found. Try a different search or department.','state')); for (const p of data.products) { const card=el('article',null,'product'); const image=el('button',null,'product-image'); image.setAttribute('aria-label',`View ${p.name}`); image.onclick=()=>detail(p); image.append(productImage(p)); card.append(image); if(p.featured) card.append(el('span','FEATURED','tag')); const name=el('h3'); const link=el('button',p.name,'text-button'); link.style.cssText='font:inherit;text-align:left;color:inherit;line-height:inherit;margin:0'; link.onclick=()=>detail(p); name.append(link); const price=el('div',p.price>0?money(p.price):'Price on request','product-price'); price.append(el('small',`${p.price_basis || 'incl VAT'} · ${p.unit || 'EA'}`)); const addButton=el('button',p.stock_status==='Unavailable'?'Currently unavailable':'＋ Add to basket','add'); addButton.disabled=p.stock_status==='Unavailable' || !!p.price_locked; addButton.onclick=()=>add(p); card.append(el('small',p.category),name,el('p',`SKU ${p.code || '—'}`),price,addButton); grid.append(card); } $('range-title').textContent=category || (query?'Search results':'Project essentials'); $('results-meta').textContent=`${data.total} matching products · Confirm availability with your store`; $('page-label').textContent=`Page ${data.page} of ${data.pages}`; $('previous').disabled=data.page<=1; $('next').disabled=data.page>=data.pages; }
+  function renderStores() { const current=$('branch').value; $('branch').replaceChildren(new Option('Select a branch','')); $('store-list').replaceChildren(); for (const branch of data.branches) { $('branch').add(new Option(branch,branch)); const b=el('button',`${branch} ↗`); b.onclick=()=>{$('branch').value=branch; openBasket();}; $('store-list').append(b); } $('branch').value=current; if(!data.branches.length) $('store-list').append(el('p','Branch information is not currently available. Contact the team for assistance.')); }
+  function renderSpecials() { const specials=(data.specials || []).filter(s=>s.images?.length); if(!specials.length) { $('specials').replaceChildren(); const box=el('div',null,'offer-placeholder'); box.append(el('strong','Your next great find starts here.'),el('p','Current store specials appear here when published.')); const a=el('a','Browse the range →'); a.href='#catalogue'; box.append(a); $('specials').append(box); return; } $('specials').replaceChildren(); for(const s of specials) for(const image of s.images) { const url=safeURL(image.url); if(!url) continue; const a=el('a'); a.href=url; a.target='_blank'; a.rel='noopener noreferrer'; const img=el('img'); img.src=url; img.alt=s.title; img.loading='lazy'; a.append(img,el('h3',s.title)); $('specials').append(a); } }
+  async function load() { const version=++request; controller?.abort(); controller=new AbortController(); $('products').setAttribute('aria-busy','true'); $('connection').replaceChildren(); $('products').replaceChildren(el('div','Loading products…','state')); $('previous').disabled=true; $('next').disabled=true;
+    try { const url=new URL(config.cataloguePath || '/api/ecommerce/public',origin); url.search=new URLSearchParams({channel:'B2C',page:String(page),pageSize:'24',q:query,category}).toString(); const response=await fetch(url,{signal:controller.signal,cache:'no-store',credentials:'omit',headers:{Accept:'application/json'}}); if(!response.ok) throw new Error(`Catalogue returned ${response.status}`); const result=await response.json(); if(!Array.isArray(result.products) || !Array.isArray(result.categories) || !Array.isArray(result.branches) || !Number.isFinite(result.total) || !Number.isInteger(result.page) || !Number.isInteger(result.pages) || result.pages<1) throw new Error('Unexpected catalogue response'); if(version!==request) return; data=result; page=result.page; populateDepartments(data.categories); renderProducts(); renderStores(); renderSpecials();
+    } catch(error) { if(version!==request || error.name==='AbortError') return; $('products').replaceChildren(el('div','The catalogue is temporarily unavailable. Please try again shortly.','state')); const message=el('div','We could not load products from the store.','error'); const retry=el('button','Try again','outline'); retry.onclick=()=>void load(); message.append(retry); $('connection').replaceChildren(message); $('results-meta').textContent='Catalogue unavailable'; $('page-label').textContent='';
+    } finally { if(version===request) $('products').setAttribute('aria-busy','false'); }
+  }
+  function renderBasket() { const target=$('basket-lines'); target.replaceChildren(); if(!basket.length) target.append(el('p','Your basket is empty. Explore the range to start your project list.')); for(const p of basket) { const row=el('div',null,'basket-line'); row.append(el('strong',p.name),el('p',p.price>0?`${money(p.price)} each · saved estimate`:'Price to be confirmed')); const qty=el('div',null,'qty'); const minus=el('button','−'); minus.setAttribute('aria-label',`Reduce ${p.name}`); minus.onclick=()=>{p.qty--; basket=basket.filter(x=>x.qty>0); save(); renderBasket();}; const plus=el('button','＋'); plus.setAttribute('aria-label',`Increase ${p.name}`); plus.onclick=()=>{p.qty=Math.min(999,p.qty+1); save(); renderBasket();}; const remove=el('button','Remove'); remove.onclick=()=>{basket=basket.filter(x=>x.id!==p.id);save();renderBasket();}; qty.append(minus,el('span',String(p.qty)),plus,remove); row.append(qty); target.append(row); } const total=basket.reduce((n,p)=>n+p.price*p.qty,0); $('basket-total').textContent=`Estimated priced items: ${money(total)}${basket.some(p=>p.price<=0)?' + unpriced items':''}`; $('send-enquiry').disabled=!basket.length; $('copy-enquiry').disabled=!basket.length; }
+  function openBasket() { renderBasket(); $('enquiry-message').textContent=''; if(!$('basket').open) $('basket').showModal(); }
+  function enquiry() { return ['PowerBuild product enquiry',`Branch: ${$('branch').value || 'Please advise nearest branch'}`,`Preference: ${$('fulfilment').value}`,'',...basket.map(p=>`${p.qty} × ${p.name} (${p.code || p.id}) — ${p.price>0?money(p.price)+' each, estimated':'price required'}`),'','Please confirm current prices, stock and fulfilment. This is an enquiry, not a confirmed order.'].join('\n'); }
+  function whatsapp() { let number=String(config.whatsapp || data?.settings?.support_whatsapp || '').replace(/\D/g,''); if(number.startsWith('0')) number='27'+number.slice(1); return /^\d{8,15}$/.test(number)?number:''; }
+  $('search').onsubmit=e=>{e.preventDefault();query=$('query').value.trim();page=1;void load();$('catalogue').scrollIntoView();};
+  $('category').onchange=()=>selectCategory($('category').value);
+  $('previous').onclick=()=>{if(page>1){page--;void load();$('catalogue').scrollIntoView();}};
+  $('next').onclick=()=>{if(data && page<data.pages){page++;void load();$('catalogue').scrollIntoView();}};
+  $('open-basket').onclick=openBasket;
+  document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>$(b.dataset.close).close());
+  document.querySelectorAll('[data-search]').forEach(b=>b.onclick=()=>{category='';query=b.dataset.search;$('query').value=query;$('category').value='';page=1;void load();$('catalogue').scrollIntoView();});
+  $('send-enquiry').onclick=()=>{const number=whatsapp(); if(!number){$('enquiry-message').textContent='WhatsApp contact is not configured. Copy your enquiry and send it to your preferred branch.';return;} if(!$('branch').value && data?.branches?.length){$('enquiry-message').textContent='Choose your preferred branch first.';$('branch').focus();return;} window.open(`https://wa.me/${number}?text=${encodeURIComponent(enquiry())}`,'_blank','noopener,noreferrer');};
+  $('copy-enquiry').onclick=async()=>{try{await navigator.clipboard.writeText(enquiry());$('enquiry-message').textContent='Enquiry copied. Send it to your preferred branch.';}catch{$('enquiry-message').textContent='Clipboard is unavailable. Select and copy the text below.';const text=el('textarea');text.value=enquiry();text.readOnly=true;text.style.cssText='width:100%;height:180px';$('enquiry-message').append(text);text.select();}};
+  $('contact').onclick=()=>{const n=whatsapp();if(n)window.open(`https://wa.me/${n}`,'_blank','noopener,noreferrer');else{$('stores').scrollIntoView();toast('Please contact your preferred branch.');}};
+  if(config.logoUrl){const u=safeURL(config.logoUrl);if(u){const img=el('img');img.src=u;img.alt='PowerBuild';img.onerror=()=>img.remove();document.querySelector('.brand').prepend(img);img.onload=()=>document.querySelector('.official-header-logo').hidden=true;}}
+  $('year').textContent=new Date().getFullYear(); save(); void load();
+  let lastRefresh=Date.now(); window.addEventListener('focus',()=>{if(Date.now()-lastRefresh>30000){lastRefresh=Date.now();void load();}});
+})();
